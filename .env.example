# Copy to .env. Optional -- the system runs without a key using the
# extractive generation fallback. Add a key to get LLM-drafted answers.
OPENROUTER_API_KEY=
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
DATA_DIR=./data
DATABASE_PATH=./storage/decisions.db
CONFIDENCE_THRESHOLD=0.55

# Required to call /admin/halt and /admin/resume (the kill switch). Left at
# this default, the endpoints work but a startup warning is emitted -- set a
# real value before running anywhere reachable by more than your own machine.
ADMIN_TOKEN=change-me

# GET /admin/reveal-token hands back the real ADMIN_TOKEN above -- it is a
# local-dev convenience for the console's "Show" button, gated by nothing on
# the server (only a client-side puzzle in the UI, which is not a real
# access control). Set to false before running this anywhere reachable by
# more than your own machine.
EXPOSE_ADMIN_TOKEN_ENDPOINT=true

# Optional -- if set (and `pip install langsmith` has been run), pipeline
# stages are traced to LangSmith. Unset by default: tracing is then a no-op
# and the system stays fully offline. See src/tracing.py.
LANGSMITH_API_KEY=
